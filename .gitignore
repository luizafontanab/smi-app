# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.next-visual/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# persistent dev server state (pnpm dev:start / dev:stop)
/.dev-server/

# visual regression: run output and login state.
# tests/visual/baseline/ IS committed — it is the reference the suite compares to.
# .state/ holds live Supabase refresh tokens and must never be.
/tests/visual/.runs/
/tests/visual/.state/

# smoke suite login state — live Supabase refresh tokens, never committed
/tests/smoke/.auth/

# env files (can opt-in for committing if needed)
.env*
# ...except the documented template, which holds no secrets
!.env.example

# database dumps — data.sql contains auth.users (member emails + password
# hashes). Never committed. Not a substitute for a Supabase dashboard backup:
# a pg_dump carries no storage bytes and no project config.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client feedback PDFs stay local: they can carry screenshots of client data,
# and at several MB each they bloat every clone.
docs/*.pdf

# A Stripe backup code was found sitting here on 21 Oct 2026. Never committed;
# it belongs in a password manager, not the tree (HUMAN-TODO 6.8).
docs/stripe_backup_code.txt
