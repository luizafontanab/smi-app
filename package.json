{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3100",
    "dev:start": "scripts/dev-server.sh start",
    "dev:stop": "scripts/dev-server.sh stop",
    "dev:status": "scripts/dev-server.sh status",
    "dev:logs": "scripts/dev-server.sh logs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "visual": "tsx tests/visual/runner.ts",
    "visual:accept": "tsx tests/visual/accept.ts",
    "visual:server": "tsx tests/visual/lib/server.ts",
    "visual:report": "open tests/visual/.runs/latest/report.html",
    "seed": "tsx scripts/seed.ts",
    "seed:real": "tsx scripts/seed-real.ts",
    "db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "db:push:prod": "supabase db push --linked",
    "seed:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/seed-real.ts --remote",
    "taxonomies:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/seed-real.ts --remote --taxonomies-only",
    "industries:backfill": "tsx scripts/backfill-industries.ts",
    "industries:backfill:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/backfill-industries.ts --remote",
    "accounts:test": "tsx scripts/create-test-accounts.ts",
    "accounts:test:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/create-test-accounts.ts --remote",
    "audit:test-rows": "tsx scripts/audit-test-rows.ts",
    "audit:test-rows:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/audit-test-rows.ts --remote",
    "remove-sample-adverts": "tsx scripts/remove-sample-adverts.ts",
    "remove-sample-adverts:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/remove-sample-adverts.ts --remote",
    "sources:import": "tsx scripts/import-sources.ts",
    "sources:import:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/import-sources.ts --remote",
    "verify:import": "tsx scripts/verify-import.ts",
    "verify:prod": "set -a && . ./.env.production.local && set +a && tsx scripts/verify-import.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "cheerio": "^1.2.0",
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
