# SMI app — environment variables.
#
# Copy to .env.local and fill in. Every variable is read as raw `process.env.X`;
# there is no schema validation, so this file is the reference for what exists.
# README.md carries the full "effect if unset" table.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Local values come from `supabase status` (ports 563xx, see supabase/config.toml).
# NEXT_PUBLIC_* are inlined at build time — changing them in Vercel needs a redeploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Required in production: /api/cron fails closed without it and NO background
# job runs. scripts/job-runner.ts also refuses to start.
CRON_SECRET=

# ── Email (TECH-DECISIONS #7 — Resend, transactional and marketing) ──────────
# Unset  → local Mailpit if MAILPIT_URL is set, otherwise a console log.
# Set    → real sends. The sender THROWS on a provider rejection, so a bad key
#          or an unverified domain surfaces in "Needs You Today" rather than
#          failing silently. Use a domain-restricted key outside production.
RESEND_API_KEY=

# Defaults to "SMI <noreply@sheetmetalindustries.com>". Point staging at its own
# verified subdomain so a mistake there can't hurt the production domain's
# sending reputation.
EMAIL_FROM=

# Optional but recommended: a monitored address. Without it, a member replying
# to "your advert needs a change" reaches nobody.
EMAIL_REPLY_TO=

# Admin notifications (contact enquiries, signups). No fallback on purpose —
# the old jas@smi.local default was undeliverable and bounced silently.
ADMIN_EMAIL=

# ── Error log (docs/logging.md) ──────────────────────────────────────────────
# Where error alerts and the daily error digest go — the developer, never Jas.
# Unset → errors are still recorded, but nobody is emailed.
DEV_ALERT_EMAIL=
# Comma-separated login emails allowed to see /console/errors. There is no
# developer role (Jas is an admin too), so this list is the gate. Unset → the
# page 404s for everyone.
DEVELOPER_EMAILS=

# Local mail catcher, from `supabase status`. Dev only.
MAILPIT_URL=http://127.0.0.1:56324

# ── Newsletter ───────────────────────────────────────────────────────────────
# Resend Audience/Segment holding subscribed contacts. Unset → the logging
# stub, and issues are left as drafts rather than being marked sent.
RESEND_SEGMENT_ID=

# Signing secret for /api/webhooks/resend, so unsubscribes, bounces and
# complaints can be mirrored back into `contacts`. Unset → the route rejects.
RESEND_WEBHOOK_SECRET=

# Signs the confirmation link /unsubscribe emails to a typed address, so only
# someone who can read that inbox can take it off the list (links last 72h).
# At least 32 characters — `openssl rand -base64 32`. Unset or shorter → the
# typed form is off and points people at the link in the newsletter itself.
# Rotating it invalidates any confirmation links already sent.
UNSUBSCRIBE_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# Falls back to the deployment's own origin, then localhost:3100. Set once there
# is a real domain: sitemap, canonical/OG tags and every email link use it.
SITE_URL=

# ── Social posting (TECH-DECISIONS #10 — Buffer) ─────────────────────────────
# Unset → LoggingSocialStub (prints what it would post). Set → real posts via
# Buffer's GraphQL API (api.buffer.com). The key is a personal API key from
# Buffer's own Settings → API — only an organisation OWNER can create one — not
# a v1 developer app credential; Buffer stopped issuing those in 2019, which is
# why the old REST path could never have authenticated (GAPS B4.4).
# Quota is per Buffer plan (Free: 3,000 requests / 30 days) and we spend one
# request per channel per post, not one per post.
# Channel ids are set in the console, not here: /console/stories → Buffer channels.
BUFFER_ACCESS_TOKEN=

# ── Social reach follower counts (issue #4, docs/social-reach.md) ───────────
# Guidance on /console/social-reach only; the homepage figure is always typed in
# by an admin. Each platform is independent. Unset → no request is made and its
# row says "Not connected: enter by hand". Set → the daily `social_followers`
# job fetches that platform's follower count. HUMAN-TODO 1.23–1.25.
# Facebook: the Page's numeric id and a long-lived Page access token
# (pages_read_engagement). Both needed.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram (API with Instagram Login, instagram_business_basic): a long-lived
# token, set the day it's generated. The job refreshes it weekly and keeps the
# refreshed one in the `settings` table; pasting a new value here replaces it.
INSTAGRAM_ACCESS_TOKEN=
# YouTube Data API v3 key. Public statistics only, no OAuth.
YOUTUBE_API_KEY=
# Optional. Defaults to SMI's channel, UCwg7Css79gc_adlmO3_fVxA.
YOUTUBE_CHANNEL_ID=

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Unset → LocalStubPayments (card path simulates success, no charge). Set all
# three → real Stripe Checkout; getPayments()/paymentsAreLive() both branch on
# STRIPE_SECRET_KEY, so /dashboard/pay's copy stops claiming "not simulated"
# only once this is real (GAPS C5).
STRIPE_SECRET_KEY=
# The £40/mo subscription Price id from the Stripe dashboard.
STRIPE_PRICE_ID=
# Signing secret for /api/stripe/webhook (checkout.session.completed,
# checkout.session.async_payment_succeeded, invoice.payment_failed).
# Unset → the route rejects with 503.
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_…) for embedded Checkout on /dashboard/pay/invoice —
# advertising invoices (src/lib/adapters/advert-checkout.ts). Advert payments
# go live only with BOTH this and STRIPE_SECRET_KEY set. Unset in production →
# priced adverts are not held for payment and Jas invoices by hand; unset
# locally → a "Pay (simulated)" button settles the invoice instead.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Maps (Google) ─────────────────────────────────────────────────────────────
# Draws the directory, events and member-profile maps (src/components/
# PinMapImpl.tsx). Unset → those maps show "Map unavailable"; the rest of the
# page still renders. Public by design (it ships to every browser), so lock it
# in Google Cloud to HTTP referrers for this site's domains + localhost:3100,
# and to the Maps JavaScript API only (HUMAN-TODO). Pin locations still come
# from OpenStreetMap's free geocoder at save time — no Geocoding API needed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID from Google Cloud → Map Management (markers need one).
# Unset → Google's DEMO_MAP_ID, which works but can't be styled.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── CRM (TECH-DECISIONS #11 — Bigin/Zoho) ─────────────────────────────────────
# Unset → LocalMirrorCrmStub (pushContact just logs, nothing is pulled). Set
# all three → two-way sync against Bigin's v2 REST API (/bigin/v2/…).
# Generate the refresh token with a Zoho API Console "Self Client", portal
# Bigin, with these scopes (HUMAN-TODO 7.2):
#   ZohoBigin.modules.contacts.ALL,ZohoBigin.modules.accounts.READ,
#   ZohoSearch.securesearch.READ,ZohoBigin.notifications.ALL
BIGIN_CLIENT_ID=
BIGIN_CLIENT_SECRET=
BIGIN_REFRESH_TOKEN=
# Region-specific hosts (Zoho accounts are pinned to a data centre at
# creation). Default to the EU data centre; override for .com/.in/etc.
# Canada's accounts host is accounts.zohocloud.ca, not zoho.ca.
BIGIN_ACCOUNTS_BASE=https://accounts.zoho.eu
BIGIN_API_BASE=https://www.zohoapis.eu
# Shared secret Bigin echoes back on every change notification to
# /api/webhooks/bigin (max 50 chars — e.g. `openssl rand -hex 24`). Unset →
# no live updates from Bigin; the crm_sync poll still picks changes up.
BIGIN_WEBHOOK_TOKEN=

# ── Story rewrite (Anthropic) ─────────────────────────────────────────────────
# "Start story" on /console/sources rewrites the article from the company's
# "we" to third person (src/lib/adapters/rewrite.ts). Unset → the draft keeps
# the article's own wording and says so. SMI-owned account (HUMAN-TODO 1.21).
ANTHROPIC_API_KEY=

# ── Mock integrations (Preview only) ──────────────────────────────────────────
# Set to "1" ONLY on the Vercel Preview environment scope, never Production
# (mock-base-url.ts also hard-checks VERCEL_ENV as a second safety net).
# Redirects the Stripe and Bigin adapters above to this deployment's own
# /api/mock/* routes, so a Preview build exercises a real HTTP round-trip —
# including signed webhooks — without a live vendor account.
MOCK_INTEGRATIONS=

# ── Visitor analytics ─────────────────────────────────────────────────────────
# IP → company lookup for /dashboard/stats (GAPS B2.2, parked for Phase 1).
# "vendor" is reserved for a company-lookup API behind src/lib/adapters/
# company-resolver.ts; until one is wired (cost + UK-GDPR sign-off first) the
# value changes nothing, and region and company stay null either way.
COMPANY_RESOLVER=
